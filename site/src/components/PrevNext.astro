---
import { docHref } from "../lib/docs-nav";
import type { Doc } from "../lib/docs-nav";

interface Props {
  prev: Doc | null;
  next: Doc | null;
}
const { prev, next } = Astro.props;
---

<nav class="mt-12 grid grid-cols-2 gap-4 border-t border-border pt-6">
  <div>
    {
      prev && (
        <a href={docHref(prev.id)} class="@card-interactive @stack-xs block">
          <span class="@caption font-mono">← prev</span>
          <span class="font-mono text-sm text-foreground">{prev.data.title}</span>
        </a>
      )
    }
  </div>
  <div class="text-right">
    {
      next && (
        <a href={docHref(next.id)} class="@card-interactive @stack-xs block">
          <span class="@caption font-mono">next →</span>
          <span class="font-mono text-sm text-foreground">{next.data.title}</span>
        </a>
      )
    }
  </div>
</nav>
