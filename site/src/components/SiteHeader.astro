---
import ThemeToggle from "./ThemeToggle.astro";
import { rc } from "../lib/expand";

const GITHUB = "https://github.com/raymond-UI/shortwind";
const links = [
  { href: "/docs", label: "docs" },
  { href: "/catalog", label: "catalog" },
  { href: "/playground", label: "playground" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="@surface sticky top-0 z-40 border-b border-border/80 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="@wrapper @row-between h-14">
    <a href="/" class="@row gap-1.5 font-mono text-sm font-bold tracking-tight">
      <span class="@term">▚</span><span>shortwind</span>
    </a>

    {/* desktop nav */}
    <nav class="@nav hidden sm:flex">
      {
        links.map((l) => (
          <a href={l.href} class={isActive(l.href) ? rc("@nav-link-active") : rc("@nav-link")}>
            {l.label}
          </a>
        ))
      }
      <a href={GITHUB} target="_blank" rel="noreferrer" class="@nav-link">github</a>
      <span class="mx-1 h-5 w-px bg-border"></span>
      <ThemeToggle />
    </nav>

    {/* mobile: toggle + menu button */}
    <div class="flex items-center gap-1 sm:hidden">
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="@nav-link px-2"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* mobile dropdown */}
  <nav id="mobile-nav" class="@surface hidden border-t border-border sm:hidden">
    <div class="@wrapper flex flex-col py-2">
      {links.map((l) => <a href={l.href} class="@nav-link">{l.label}</a>)}
      <a href={GITHUB} target="_blank" rel="noreferrer" class="@nav-link">github</a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-nav");
    btn?.addEventListener("click", () => {
      const open = menu?.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
    });
  })();
</script>
