---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
// Skip the page title (depth 1); show H2/H3 only.
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length > 0 && (
    <nav aria-label="On this page" class="@stack-xs">
      <p class="@eyebrow mb-3">On this page</p>
      {items.map((h) => (
        <a
          href={`#${h.slug}`}
          class={
            "block py-0.5 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground " +
            (h.depth === 3 ? "pl-3" : "")
          }
        >
          {h.text}
        </a>
      ))}
    </nav>
  )
}
