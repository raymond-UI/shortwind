---
import { docHref } from "../lib/docs-nav";
import { rc } from "../lib/expand";
import type { Doc } from "../lib/docs-nav";

interface Props {
  docs: Doc[];
  current: string;
}
const { docs, current } = Astro.props;
---

<nav aria-label="Documentation" class="@stack-xs">
  <p class="@eyebrow mb-3">Documentation</p>
  {
    docs.map((d) => {
      const active = d.id === current;
      return (
        <a
          href={docHref(d.id)}
          aria-current={active ? "page" : undefined}
          class={
            "flex items-center gap-2 rounded-md px-2 py-1 font-mono text-sm transition-colors " +
            (active
              ? "text-foreground"
              : "text-muted-foreground hover:bg-muted hover:text-foreground")
          }
        >
          <span class={active ? rc("@term") : "text-transparent"} aria-hidden="true">
            ›
          </span>
          <span class="truncate">{d.data.title}</span>
        </a>
      );
    })
  }
</nav>
