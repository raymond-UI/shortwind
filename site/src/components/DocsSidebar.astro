---
import { docHref, sortedDocs } from "../lib/docs-nav";
import type { Doc } from "../lib/docs-nav";

interface Props {
  docs: Doc[];
  current: string;
}
const { docs, current } = Astro.props;

// Everything the markup needs is derived here, so the template below is a flat
// map with no branching in it.
const LINK = "flex items-center gap-2 rounded-md px-2 py-1 font-mono text-sm transition-colors ";
const items = sortedDocs(docs).map((d) => {
  const active = d.id === current;
  return {
    href: docHref(d.id),
    title: d.data.title,
    current: active ? ("page" as const) : undefined,
    linkClass:
      LINK +
      (active
        ? "text-foreground"
        : "text-muted-foreground hover:bg-muted hover:text-foreground"),
    markerClass: active ? "text-foreground" : "text-transparent",
  };
});
---

<nav aria-label="Documentation" class="@stack-sm">
  <div class="@stack-xs pt-1">
    {
      items.map((item) => (
        <a href={item.href} aria-current={item.current} class={item.linkClass}>
          <span class={item.markerClass} aria-hidden="true">
            ›
          </span>
          <span class="truncate">{item.title}</span>
        </a>
      ))
    }
  </div>
</nav>
