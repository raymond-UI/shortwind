---
const GITHUB = "https://github.com/raymond-UI/shortwind";
const NPM = "https://www.npmjs.com/package/@shortwind/cli";
const year = 2026;
---

<footer class="@surface mt-24 border-t border-border">
  <div class="@wrapper flex flex-col gap-4 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="@stack-xs">
      <div class="@row gap-1.5 font-mono text-sm font-bold">
        <span class="@term">▚</span><span>shortwind</span>
      </div>
      <p class="@caption">A token-efficient @recipe class layer for Tailwind.</p>
    </div>
    <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-muted-foreground">
      <a href="/docs" class="hover:text-foreground">docs</a>
      <a href="/catalog" class="hover:text-foreground">catalog</a>
      <a href="/playground" class="hover:text-foreground">playground</a>
      <a href={NPM} target="_blank" rel="noreferrer" class="hover:text-foreground">npm</a>
      <a href={GITHUB} target="_blank" rel="noreferrer" class="hover:text-foreground">github</a>
      <span class="text-muted-foreground/60">© {year}</span>
    </nav>
  </div>
</footer>
