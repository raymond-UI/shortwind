---
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import Toc from "../components/Toc.astro";
import PrevNext from "../components/PrevNext.astro";
import type { Doc } from "../lib/docs-nav";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description?: string;
  docs: Doc[];
  current: string;
  headings: Heading[];
  prev: Doc | null;
  next: Doc | null;
}
const { title, description, docs, current, headings, prev, next } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div
    class="@wrapper grid grid-cols-1 gap-10 py-10 lg:grid-cols-[12rem_minmax(0,1fr)_12rem]"
  >
    <aside class="hidden lg:block">
      <div class="sticky top-20">
        <DocsSidebar docs={docs} current={current} />
      </div>
    </aside>

    <article class="min-w-0">
      <header class="@stack-sm mb-8 border-b border-border pb-6">
        <p class="@eyebrow">Docs</p>
        <h1 class="@heading-xl">{title}</h1>
        {description && <p class="@lead">{description}</p>}
      </header>
      <div class="prose-doc"><slot /></div>
      <PrevNext prev={prev} next={next} />
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20">
        <Toc headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>
