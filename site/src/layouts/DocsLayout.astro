---
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import Toc from "../components/Toc.astro";
import PrevNext from "../components/PrevNext.astro";
import type { Doc } from "../lib/docs-nav";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description?: string;
  docs: Doc[];
  current: string;
  headings: Heading[];
  prev: Doc | null;
  next: Doc | null;
}
const { title, description, docs, current, headings, prev, next } =
  Astro.props;
---

{/* App shell (like /catalog and /playground): header fixed, nav · article · TOC
    each scroll independently, the page itself never scrolls. */}
<BaseLayout title={title} description={description} appShell>
  <div class="grid h-full grid-cols-1 grid-rows-1 lg:grid-cols-[15rem_minmax(0,1fr)_14rem]">
    {/* documentation nav — scrolls independently */}
    <aside class="hidden min-h-0 overflow-y-auto border-r border-border bg-card/40 px-5 py-8 lg:block">
      <DocsSidebar docs={docs} current={current} />
    </aside>

    {/* article — scrolls independently */}
    <article class="min-h-0 min-w-0 overflow-y-auto">
      {/* mobile docs nav — the left sidebar (page list) is desktop-only, so
          below `lg` surface the same component as a no-JS disclosure pinned to
          the top of the article scroll. */}
      <details class="group border-b border-border lg:hidden">
        <summary class="sticky top-0 z-10 flex cursor-pointer list-none items-center justify-between bg-background/95 px-6 py-3 backdrop-blur [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-2 font-mono text-sm">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <span class="font-medium">Docs</span>
          </span>
          <svg
            class="text-muted-foreground transition-transform group-open:rotate-180"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="px-6 pb-6 pt-3">
          <DocsSidebar docs={docs} current={current} />
        </div>
      </details>

      <div class="mx-auto max-w-3xl px-6 py-10 lg:px-12">
        <header class="@stack-sm mb-8 border-b border-border pb-6">
          <p class="@eyebrow flex items-center gap-1.5">
            <span>Docs</span>
          </p>
          <h1 class="@heading-xl">{title}</h1>
          {description && <p class="@lead">{description}</p>}
        </header>
        <div class="prose-doc"><slot /></div>
        <PrevNext prev={prev} next={next} />
      </div>
    </article>

    {/* on this page — scrolls independently */}
    <aside class="hidden min-h-0 overflow-y-auto border-l border-border px-5 py-8 lg:block">
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>
