---
import BaseLayout from "../layouts/BaseLayout.astro";
import Prompt from "../components/Prompt.astro";
import SectionRule from "../components/SectionRule.astro";
import { loadCatalog } from "../lib/catalog-data";
import { expand } from "@shortwind/core";

const { families, registry } = loadCatalog();
const recipeCount = families.reduce((n, f) => n + f.recipes.length, 0);
const familyCount = families.length;

// Real, build-time expansion — the value prop, computed by the published core.
// Splitting the @ keeps the Shortwind transform from expanding this source.
const AT = "@";
const demoSource = [
  `<div class="${AT}card">`,
  `  <p class="${AT}eyebrow">Revenue</p>`,
  `  <h3 class="${AT}heading-md">$48,120</h3>`,
  `  <p class="${AT}muted">+12.5% MoM</p>`,
  `</div>`,
].join("\n");
const demoExpanded = expand(demoSource, registry, { mode: "html" });
// Token counts measured with the Claude Opus 4.8 tokenizer (v0-tokenizer) for
// these exact demo strings (134-char source → 55 tok, 312-char expansion → 93).
// The demo is fixed, so no tokenizer dependency is needed. Re-measure only if
// demoSource/demoExpanded change.
const sourceTokens = 55;
const expandedTokens = 93;
const shrink = Math.round(((expandedTokens - sourceTokens) / expandedTokens) * 100);
---

<BaseLayout
  title="Shortwind"
  description="Tailwind shorthand for the LLM era — models write @card, the build expands it to byte-identical Tailwind."
>
  {/* Gradient hairline — the one bit of color, pinned above the sticky header. */}
  <div class="sw-hairline" aria-hidden="true"></div>
  {/* Atmosphere: faint engineering grid + a neutral spotlight behind the hero.
      Both sit at z-index:-1, so opaque panels float above and the transparent
      hero reads through to the texture. Scoped to this page only. */}
  <div class="sw-grid" aria-hidden="true"></div>
  <div class="sw-glow" aria-hidden="true"></div>

  {/* ── Hero ───────────────────────────────────────────────────────────── */}
  <div class="@wrapper max-w-2xl pt-20 text-center sm:pt-28">
    <span class="sw-rise @badge-outline font-mono" style="--d:0ms">
      <span class="sw-pulse mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-term align-middle"></span>v0.1 · public beta
    </span>
    <h1 class="sw-rise mt-6 font-mono text-[1.75rem] font-extrabold leading-[1.2] tracking-tight text-balance sm:text-4xl sm:leading-[1.1] md:text-5xl" style="--d:80ms">
      Let the model write<br class="hidden sm:inline" />
      <span class="@term">@card</span>, not forty classes.
    </h1>
    <p class="sw-rise @lead mt-5 max-w-lg text-pretty" style="--d:160ms">
      Recipes are Tailwind shorthand an LLM writes instead of walls of
      utilities — expanded to byte-identical CSS at build. Same render,
      <span class="text-foreground">{shrink}% fewer tokens</span>.
    </p>
    <div class="sw-rise @row mt-8 flex-wrap justify-center gap-3" style="--d:240ms">
      <a href="/docs/install" class="@btn-primary">Get started →</a>
      <a href="/docs" class="@btn-secondary">Read the docs</a>
    </div>
  </div>

  {/* ── Demo: @recipe source (cheap) → expanded Tailwind (the wall) → identical render ── */}
  <div class="@wrapper mt-20 max-w-3xl sm:mt-24">
    <SectionRule label="Demo" meta="Opus 4.8" />
    <section class="sw-panel mt-5 overflow-hidden rounded-lg border border-border text-left">
      <div class="@row border-b border-border bg-card px-4 py-2.5">
        <span class="h-2.5 w-2.5 rounded-full bg-destructive/70"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-muted-foreground/40"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-term/70"></span>
        <span class="@caption ml-2">Dashboard.tsx</span>
      </div>

      {/* two panes: what the model writes vs what the build emits */}
      <div class="grid gap-px bg-border md:grid-cols-2">
        <div class="bg-background p-5">
          <div class="@row-between mb-3">
            <span class="@caption">model writes</span>
            <span class="@badge-outline font-mono">{sourceTokens} tok</span>
          </div>
          <pre class="overflow-x-auto font-mono text-xs leading-6 text-foreground/85">{demoSource}</pre>
        </div>
        <div class="bg-background p-5">
          <div class="@row-between mb-3">
            <span class="@caption">build emits</span>
            <span class="@badge font-mono">{expandedTokens} tok</span>
          </div>
          <pre class="font-mono text-xs leading-6 break-words whitespace-pre-wrap text-muted-foreground">{demoExpanded}</pre>
        </div>
      </div>

      {/* both produce identical pixels */}
      <div class="border-t border-border bg-background p-5">
        <div class="mb-4 flex items-center gap-3 font-mono text-xs text-muted-foreground">
          <div class="h-px flex-1 bg-border"></div>
          <span class="@term">both render identically · {shrink}% fewer tokens · Opus 4.8</span>
          <div class="h-px flex-1 bg-border"></div>
        </div>
        {/* SECURITY: set:html is the one raw-HTML sink in the tree. `demoExpanded`
            MUST stay a build-time constant (expand() over the hardcoded demoSource
            above) — never feed user/runtime input here. The site-wide CSP in
            public/_headers is the backstop. */}
        <div
          class="mx-auto max-w-xs rounded border border-dashed border-border p-5"
          set:html={demoExpanded}
        />
      </div>
    </section>
  </div>

  {/* ── Steps · families · install ─────────────────────────────────────── */}
  <div class="@wrapper max-w-2xl pb-24 text-center">

    {/* ── How it works: numbered list ──────────────────────────────────── */}
    <section class="mx-auto mt-24 max-w-xl text-left">
      <SectionRule label="How it works" />
      <ol class="mt-6 space-y-5">
        <li class="@row items-start gap-4">
          <span class="@term">01</span>
          <div>
            <h3 class="@heading-sm font-mono">Own your recipes</h3>
            <p class="@muted">
              <code class="@code-inline">init</code> copies a
              <code class="@code-inline">recipes/</code> folder you edit. Versioned, yours, no black box.
            </p>
          </div>
        </li>
        <li class="@row items-start gap-4">
          <span class="@term">02</span>
          <div>
            <h3 class="@heading-sm font-mono">Agents write @card</h3>
            <p class="@muted">
              A generated <code class="@code-inline">SKILL.md</code> hands your coding agents the whole recipe palette.
            </p>
          </div>
        </li>
        <li class="@row items-start gap-4">
          <span class="@term">03</span>
          <div>
            <h3 class="@heading-sm font-mono">Build expands it</h3>
            <p class="@muted">
              Recipes compile to Tailwind. Identical CSS, nothing extra shipped to the browser.
            </p>
          </div>
        </li>
      </ol>
    </section>

    {/* ── Families ─────────────────────────────────────────────────────── */}
    <section class="mx-auto mt-24 max-w-xl text-left">
      <SectionRule label="Catalog" meta={`${familyCount} families · ${recipeCount} recipes`} />
      <div class="@row mt-6 flex-wrap justify-center">
        {
          families.map((f) => (
            <a
              href={`/catalog#fam-${f.name}`}
              class="@badge-outline font-mono transition-colors hover:border-term hover:text-foreground"
            >
              {f.name}
            </a>
          ))
        }
      </div>
    </section>

    {/* ── Install ──────────────────────────────────────────────────────── */}
    <div class="mx-auto mt-10 max-w-md"><Prompt code="npx @shortwind/cli@beta init" /></div>
  </div>
</BaseLayout>

<style>
  /* Pinned 2px gradient accent — the single hit of color in the layout. Sits
     above the sticky header (z-40) so it reads as a top frame on every scroll. */
  .sw-hairline {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 50;
    background: linear-gradient(
      90deg,
      transparent,
      oklch(0.6 0.2 277),
      oklch(0.65 0.22 320),
      transparent
    );
    box-shadow: 0 0 18px oklch(0.6 0.2 277 / 60%);
  }

  /* Engineering graph-paper grid. Uses --border so it tracks the theme, then a
     radial mask fades it out below the fold so it reads as texture, not a table.
     Sits behind content; opaque panels paint over it. */
  .sw-grid {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(120% 70% at 50% 0%, #000 0%, transparent 68%);
    mask-image: radial-gradient(120% 70% at 50% 0%, #000 0%, transparent 68%);
    opacity: 0.6;
  }

  /* Neutral spotlight behind the hero — depth without adding a hue. Bright in
     dark mode (foreground is near-white), near-invisible in light mode by design. */
  .sw-glow {
    position: fixed;
    inset: 0 0 auto 0;
    height: 60vh;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      44rem 26rem at 50% -6rem,
      color-mix(in oklch, var(--foreground) 6%, transparent),
      transparent 70%
    );
  }

  /* Panels lift off the textured background: a hairline top highlight inside,
     plus a soft long shadow. Tuned to stay subtle in both themes. */
  .sw-panel {
    box-shadow:
      inset 0 1px 0 0 color-mix(in oklch, var(--foreground) 6%, transparent),
      0 24px 50px -32px oklch(0 0 0 / 55%);
  }

  /* Hero load: staggered rise. Each element sets its own --d delay inline. */
  .sw-rise {
    opacity: 0;
    animation: sw-rise-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes sw-rise-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Live-beta pulse on the badge dot. */
  .sw-pulse {
    animation: sw-pulse 2.4s ease-in-out infinite;
  }
  @keyframes sw-pulse {
    0%, 100% {
      opacity: 1;
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--term) 55%, transparent);
    }
    50% {
      opacity: 0.7;
      box-shadow: 0 0 0 0.25rem transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sw-rise,
    .sw-pulse {
      animation: none;
      opacity: 1;
    }
  }
</style>
