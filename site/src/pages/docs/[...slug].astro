---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { sortedDocs, prevNext } from "../../lib/docs-nav";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  const ordered = sortedDocs(docs);
  return ordered.map((entry) => ({
    // `index` lives at /docs; everything else at /docs/<slug>.
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry, ordered },
  }));
}

const { entry, ordered } = Astro.props;
const { Content, headings } = await render(entry);
const { prev, next } = prevNext(ordered, entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  docs={ordered}
  current={entry.id}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>
