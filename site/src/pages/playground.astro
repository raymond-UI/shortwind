---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaygroundStudio from "../islands/PlaygroundStudio.tsx";
import { flattenedRegistry } from "../lib/catalog-data";

// expand() reads only registry.flattened, so the flattened map (recipe → tokens)
// is all the island needs. Built here at build time, shipped as a prop.
const flattened = flattenedRegistry();
---

<BaseLayout
  title="Playground"
  description="Type @recipe shorthand and watch it expand to Tailwind, live — with honest token counts and the full recipe palette."
  appShell
>
  <PlaygroundStudio client:load flattened={flattened} />
</BaseLayout>
