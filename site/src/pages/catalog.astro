---
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogBrowser from "../islands/CatalogBrowser.tsx";
import { loadCatalog, flattenedRegistry } from "../lib/catalog-data";

// Build-time: parse owned recipes → families (name, description, expansion) and
// the flattened registry (recipe → tokens) used for live previews. Both ship in
// the island's hydration payload — no runtime fetch.
const { families } = loadCatalog();
const flattened = flattenedRegistry();
const recipeCount = families.reduce((n, f) => n + f.recipes.length, 0);
---

<BaseLayout
  title="Recipe catalog"
  description="Browse every recipe in the default Shortwind registry — its expanded Tailwind class list and a live preview."
  appShell
>
  <CatalogBrowser
    client:load
    families={families}
    flattened={flattened}
    recipeCount={recipeCount}
  />
</BaseLayout>
