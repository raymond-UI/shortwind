{
  "name": "@shortwind/cli",
  "version": "0.1.0-beta.8",
  "description": "Shortwind CLI — init, add, remove, upgrade, dev, build, lint, ls, preset. Provides the `shortwind` command.",
  "type": "module",
  "bin": {
    "shortwind": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "gen:bench": "tsx scripts/generate-bench-recipes.ts",
    "gen:catalog": "tsx scripts/generate-catalog.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@shortwind/core": "workspace:*",
    "@shortwind/tailwind": "workspace:*",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "js-tiktoken": "^1.0.21",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.16"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsdown": "^0.22.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymond-UI/shortwind.git",
    "directory": "packages/cli"
  },
  "homepage": "https://shortwind.dev",
  "bugs": {
    "url": "https://github.com/raymond-UI/shortwind/issues"
  }
}
