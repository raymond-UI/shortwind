{
  "name": "@shortwind/vite",
  "version": "0.1.0-beta.14",
  "description": "Vite plugin for Shortwind. Transforms source files before Tailwind's content scan.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "dependencies": {
    "@shortwind/core": "workspace:*",
    "@shortwind/tailwind": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymond-UI/shortwind.git",
    "directory": "packages/vite"
  },
  "homepage": "https://shortwind.dev",
  "bugs": {
    "url": "https://github.com/raymond-UI/shortwind/issues"
  }
