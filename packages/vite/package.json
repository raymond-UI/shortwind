{
  "name": "@shortwind/vite",
  "version": "0.0.0",
  "description": "Vite plugin for Shortwind. Transforms source files before Tailwind's content scan.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": ">=7.0.0"
  },
  "dependencies": {
    "@shortwind/core": "workspace:*",
    "@shortwind/tailwind": "workspace:*"
  }
}
