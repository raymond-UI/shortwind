    "@babel/parser": "^7.29.3",
    "@shortwind/core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.0",
    "@types/node": "^25.7.0",
    "tailwindcss": "^4.3.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymond-UI/shortwind.git",
    "directory": "packages/tailwind"
  },
  "homepage": "https://shortwind.dev",
  "bugs": {
    "url": "https://github.com/raymond-UI/shortwind/issues"
  }
