{
  "name": "@shortwind/runtime",
  "version": "0.1.0-beta.12",
  "description": "Browser runtime for Shortwind. Walks the DOM, expands @recipe tokens, ships the default catalog inline.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "tsx scripts/generate-registry.ts",
    "bundle": "tsx scripts/bundle.ts",
    "build": "pnpm gen && tsc && pnpm bundle",
    "typecheck": "pnpm gen && tsc --noEmit",
    "test": "pnpm gen && vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@shortwind/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymond-UI/shortwind.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://shortwind.dev",
  "bugs": {
    "url": "https://github.com/raymond-UI/shortwind/issues"
  }
}
