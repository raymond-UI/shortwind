{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm --filter @shortwind/registry build && vite build && tsc",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "wrangler:dev": "wrangler dev --port=3001",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "test": "vitest run"
  },
  "dependencies": {
    "@shortwind/core": "workspace:*",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "marked": "^18.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.4",
    "@shortwind/vite": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "wrangler": "^4.90.1"
  }
}
