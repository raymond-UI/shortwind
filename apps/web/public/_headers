/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://unpkg.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# The CLI now reads the catalog from its bundled snapshot (not this endpoint),
# so /registry/* only serves the catalog browser and bring-your-own reference.
# Cache it — but briefly, with stale-while-revalidate, so updates still surface
# within a minute instead of being stuck on a stale edge copy forever (the bug
# that served @container long after the @wrapper deploy). Don't `no-store` (that
# throws away the CDN); don't cache indefinitely (that was the bug).
/registry/*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400
