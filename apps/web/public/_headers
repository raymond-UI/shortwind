/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://unpkg.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# The registry is what the CLI fetches at install/upgrade time. Cloudflare
# edge-caches .css/.json by default, which made registry updates (recipe fixes,
# version bumps) invisible until the cache expired. Serve it uncached so
# changes propagate immediately.
/registry/*
  Cache-Control: no-store
  CDN-Cache-Control: no-store
