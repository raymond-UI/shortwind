# Shortwind Cloud — deploy environment matrix (CLOUD-30b)
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets.
#
# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare (Worker serve path + R2 + KV; Phase 2 custom hostnames)
# ─────────────────────────────────────────────────────────────────────────────
# Account id is not secret. The API token MUST have these permissions:
#   - Workers Scripts: Edit
#   - Workers R2 Storage: Edit
#   - Workers KV Storage: Edit
#   - (Phase 2 bind-domain) SSL and Certificates: Edit  +  Custom Hostnames
CLOUDFLARE_ACCOUNT_ID=31d65fe8d35768972de29c4199b648ee
CLOUDFLARE_API_TOKEN=            # re-issue: the token previously supplied failed /user/tokens/verify
# Filled by `wrangler r2 bucket create` / `wrangler kv namespace create` (see DEPLOY.md):
R2_BUCKET_NAME=shortwind-artifacts          # → worker/wrangler.toml [[r2_buckets]].bucket_name
KV_NAMESPACE_ID=                            # → worker/wrangler.toml [[kv_namespaces]].id
# R2 S3-compatible API — the Convex publish action writes artifacts here:
R2_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Convex (control plane / system of record)
# ─────────────────────────────────────────────────────────────────────────────
# Project Settings → Deploy Keys in the Convex dashboard. Needed for `convex deploy`.
CONVEX_DEPLOY_KEY=
CONVEX_DEPLOYMENT=                          # e.g. prod:your-project-123 (set by `convex deploy`)
# The deployed Convex HTTP origin (https://<deployment>.convex.site) — the Worker
# cold source + the well-known/auth issuer point here:
CONVEX_HTTP_URL=                            # → worker/wrangler.toml [vars].CONVEX_HTTP_URL

# ─────────────────────────────────────────────────────────────────────────────
# Better Auth (device-flow tokens + scopes)
# ─────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=                         # generate: openssl rand -base64 32
SITE_URL=                                   # the deployed origin; backs the device verification URI + RFC 9728 issuer
DASHBOARD_URL=                              # the deployed OPERATOR DASHBOARD origin (separate Cloudflare Worker);
                                            # added to Better Auth trustedOrigins so the dashboard's web login is
                                            # accepted. Comma-separated for preview origins. e.g.
                                            # https://shortwind-cloud-dashboard.<subdomain>.workers.dev

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard (TanStack Start — built + deployed separately under apps/cloud/dashboard)
# Auth is now the operator's Better Auth WEB SESSION (no baked bearer). These are
# read at build time (Vite) and mirrored into dashboard/wrangler.jsonc [vars].
# ─────────────────────────────────────────────────────────────────────────────
VITE_CONVEX_URL=                            # https://<deployment>.convex.cloud
VITE_CONVEX_SITE_URL=                       # https://<deployment>.convex.site (Better Auth origin the /api/auth proxy targets)

# ─────────────────────────────────────────────────────────────────────────────
# CLI (consumed at runtime by `shortwind-cloud`)
# ─────────────────────────────────────────────────────────────────────────────
SHORTWIND_CLOUD_API=                        # the deployed REST origin the CLI publishes to (= SITE_URL)
