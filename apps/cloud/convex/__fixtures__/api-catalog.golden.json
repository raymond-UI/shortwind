{
  "apis": [
    {
      "rel": "find",
      "method": "GET",
      "href": "https://cloud.shortwind.dev/v1/pages?q={q}&domain={domain}&tag={tag}",
      "description": "Locate existing pages before acting (rich query prevents duplicates).",
      "scope": "pages:read"
    },
    {
      "rel": "publish",
      "method": "POST",
      "href": "https://cloud.shortwind.dev/v1/pages",
      "description": "Create a page from HTML (+ lockfile, + touched recipes). Idempotency-keyed.",
      "scope": "pages:write"
    },
    {
      "rel": "update",
      "method": "PATCH",
      "href": "https://cloud.shortwind.dev/v1/pages/{id}",
      "description": "Republish to the same URL; previous versions retained.",
      "scope": "pages:write"
    },
    {
      "rel": "get",
      "method": "GET",
      "href": "https://cloud.shortwind.dev/v1/pages/{id}",
      "description": "Metadata + version list so the agent can confirm before acting.",
      "scope": "pages:read"
    },
    {
      "rel": "delete",
      "method": "DELETE",
      "href": "https://cloud.shortwind.dev/v1/pages/{id}",
      "description": "Tombstone a page (retained, not hard-deleted).",
      "scope": "pages:write"
    },
    {
      "rel": "visibility",
      "method": "PATCH",
      "href": "https://cloud.shortwind.dev/v1/pages/{id}/visibility",
      "description": "Set public / unlisted / private.",
      "scope": "pages:write"
    },
    {
      "rel": "bind-domain",
      "method": "POST",
      "href": "https://cloud.shortwind.dev/v1/pages/{id}/domain",
      "description": "Privileged: bind a custom hostname (human-gated step-up grant).",
      "scope": "domains:bind"
    }
  ]
}
