{
  // The CLI is a Node program (process / Buffer / streams / node: builtins), so it
  // typechecks against @types/node — separate from the parent tsconfig, which types
  // against @cloudflare/workers-types + DOM (the serve Worker / Convex side). Keeping
  // them apart avoids duplicate Web/Node globals (fetch/Request/…) AND makes each
  // typecheck self-contained in the nested pnpm root (no monorepo-root @types/node to
  // accidentally lean on — which is what broke CI). `pnpm run typecheck` runs both.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  // `src` is the CLI; imported `../shared/*` files are pulled into the program
  // automatically by their imports (no need to list shared here).
  "include": ["src"]
}
